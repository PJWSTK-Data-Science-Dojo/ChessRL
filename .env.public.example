# Public named-tunnel deployment. Copy to .env.public and keep it private.
PUBLIC_HOSTNAME=play.example.com
PORT=5000

# Generate with: uv run python -c "import secrets; print(secrets.token_hex(32))"
LUNA_WEB_SECRET=

# Create with: make release-web-model RELEASE_ID=<evaluated-iteration>
MODEL_PATH=
MODEL_SHA256=

# Store only the tunnel token in this owner-only file.
CLOUDFLARE_TUNNEL_TOKEN_FILE=
CLOUDFLARED_UID=
CLOUDFLARED_GID=
CLOUDFLARED_LOG_LEVEL=info

SEARCH_SIMULATIONS=96
COMPILE_INFERENCE=false
THREADS=4
TIMEOUT=90
GRACEFUL_TIMEOUT=30
LOG_LEVEL=info
HSTS_MAX_AGE_SECONDS=31536000

WEB_CPU_LIMIT=4.0
WEB_MEMORY_LIMIT=16g
WEB_PIDS_LIMIT=256
WEB_TMPFS_SIZE=2g
