# Private loopback deployment. Copy to .env and never commit the populated file.
HOST=127.0.0.1
PORT=5000

# Generate with: uv run python -c "import secrets; print(secrets.token_hex(32))"
LUNA_WEB_SECRET=change-me
SESSION_COOKIE_SECURE=false
LUNA_TRUSTED_HOSTS=localhost,127.0.0.1
PROXY_HOPS=0
HSTS_MAX_AGE_SECONDS=0

# Create with: make release-web-model RELEASE_ID=<evaluated-iteration>
MODEL_PATH=./release/luna-evaluated-iteration.pth.tar
MODEL_SHA256=replace-with-the-64-character-sha256-digest

DEVICE=cpu
SEARCH_SIMULATIONS=96
COMPILE_INFERENCE=false

THREADS=4
TIMEOUT=180
GRACEFUL_TIMEOUT=30
LOG_LEVEL=info

WEB_CPU_LIMIT=4.0
WEB_MEMORY_LIMIT=16g
WEB_PIDS_LIMIT=256
WEB_TMPFS_SIZE=2g

# Required by make train-phase and make resume-phase. Keep populated values only
# in the Git-ignored .env file; never commit an API key.
WANDB_API_KEY=
WANDB_ENTITY=
