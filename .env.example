# Copy to .env. Never commit the populated file.
HOST=127.0.0.1
BIND_ADDRESS=127.0.0.1
PORT=5000

# Generate with: uv run python -c "import secrets; print(secrets.token_hex(32))"
LUNA_WEB_SECRET=change-me
SESSION_COOKIE_SECURE=true

DEVICE=cpu
SEARCH_SIMULATIONS=96
COMPILE_INFERENCE=false

THREADS=4
TIMEOUT=180
GRACEFUL_TIMEOUT=30
LOG_LEVEL=info
